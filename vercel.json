{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "apps/store/package.json",
      "use": "@vercel/nextjs",
      "config": { "distDir": ".next" }
    },
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 60 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/api/index.ts" },
    { "src": "/(.*)", "dest": "apps/store/$1" }
  ]
}
