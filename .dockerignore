# .dockerignore
# Ignorar arquivos desnecessários no build Docker

# Git
.git
.gitignore

# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
build
*.tsbuildinfo

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output

# Docker
Dockerfile*
docker-compose*.yml
docker-compose.override.yml

# Env files (nunca commitar .env de produção)
.env
.env.local
.env.production
.env.*.local

# Misc
*.pem
*.key
*.crt