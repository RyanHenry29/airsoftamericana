++// sql.raw   → `db.execute(sql.raw(`...`));`    (fecha com `));`)
++const stmtRe = /await\s+db\.execute\(\s*(?:sql\.raw|sql)\s*(?:\(\s*)?`([\s\S]*?)`\s*\)\s*\)?\s*;/g;
++const statements = [];
