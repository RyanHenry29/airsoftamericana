++    const stmts = s.statements.map((t) => "      " + "`" + esc(t.trimEnd()) + "`,");
++    return `  {
++    name: "${s.name}",
++    description: ${JSON.stringify(s.title)},
++    statements: [
++${stmts.join("\n")}
++    ],
++  },`;
++  })
++  .join("\n");
++
