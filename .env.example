# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Banco de dados.
# Desenvolvimento: vazio = PGlite local (data/airsoft.db), nenhum servidor necessário.
# Produção: postgres://user:pass@host:5432/airsoft
DATABASE_URL=

# Segredo JWT (obrigatório em produção — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=

# Cifra para credenciais de gateway salvas no banco (32 bytes base64)
GATEWAY_SECRETS_KEY=

# --- Loja ---
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
STORE_NAME=Airsoft Americana
STORE_WHATSAPP=

# --- Gateways (configuração alternativa por variável; no admin o lojista
# pode informar em Configurações → Pagamentos e fica gravado cifrado) ---
GATEWAY_ACTIVE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
PAGBANK_API_KEY=
CIELO_CLIENT_ID=
CIELO_CLIENT_SECRET=

# --- Logística ---
CORREIOS_CEP_API=
FRETE_GRATIS_APARTIR_DE=

# --- Observabilidade ---
LOG_LEVEL=info

# --- Limite de tentativas de acesso (padrão do SKILL) ---
# Login: 5 tentativas por minuto, bloqueio de 15 min.
AUTH_LOGIN_MAX=5
AUTH_LOGIN_WINDOW_MS=60000
AUTH_LOGIN_BLOCK_MS=900000
# Cadastro: 3 tentativas por hora, bloqueio de 24 h.
# Em desenvolvimento dá para baixar o bloqueio (ex.: 60000 = 1 min).
AUTH_REGISTER_MAX=3
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_REGISTER_BLOCK_MS=86400000

# --- Guarda global de requisições (por IP) ---
# Cobre navegação real da loja (home, catálogo, categorias, carrinho,
# configurações) sem travar o painel. As rotas de acesso têm limite próprio.
# Em desenvolvimento o loopback (127.0.0.1/::1) fica isento, porque o dev
# server refaz /api/cart a cada recarga; em produção o limite vale para todos.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
